{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "live run (3,000 transactions)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/run_live.ps1",
      "args": ["-Limit", "3000", "-Speed", "1000"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "full fraudTest evaluation (about 40 min)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/run_live.ps1",
      "args": ["-Limit", "555719", "-NoPacing"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "dbt build",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/dbt.ps1",
      "args": ["build"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "final evaluation query",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/run_sql.ps1",
      "args": ["sql/final_evaluation.sql"],
      "cwd": "${workspaceFolder}"
    }
  ]
}